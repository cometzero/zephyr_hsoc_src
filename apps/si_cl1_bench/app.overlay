/* SPDX-License-Identifier: Apache-2.0 */
/ {
	/* Explicit integration assumptions: private 128 KiB DTCM per core. */
	bench_dtcm: memory@100100000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <1 0x00100000 DT_SIZE_K(128)>;
		zephyr,memory-region = "BENCH_DTCM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};
	/* MM path, unlike the image's LLRAM: this can exercise the L2. */
	bench_cached: memory@40000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0 0x40000000 DT_SIZE_M(8)>;
		zephyr,memory-region = "BENCH_MM_SRAM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
	};
	bench_uncached: memory@48000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0 0x48000000 DT_SIZE_M(8)>;
		zephyr,memory-region = "BENCH_NC_SRAM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};
};
