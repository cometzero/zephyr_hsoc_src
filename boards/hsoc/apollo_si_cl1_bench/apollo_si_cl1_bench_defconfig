CONFIG_ARM_MPU=y
CONFIG_MEM_ATTR=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_THREAD_STACK_INFO=y
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=100000000
CONFIG_ARM_ARCH_TIMER=y
CONFIG_SERIAL=y
CONFIG_UART_PL011=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
# The board releases all four CL1 PEs at the same reset vector. Zephyr's
# existing boot-parameter protocol starts secondaries without PSCI.
CONFIG_SOC_FVP_AEMV8R_SIMULATE_CPU_PM=y
CONFIG_PM_CPU_OPS=y
CONFIG_PM_CPU_OPS_PSCI=n
CONFIG_ARM64_SET_VMPIDR_EL2=y
CONFIG_SMP=y
CONFIG_MP_MAX_NUM_CPUS=4
CONFIG_MAX_THREAD_BYTES=3
# Direct ELF loading deliberately excludes the FVP bin CRC trailer flow.
CONFIG_ENABLE_IMAGE_INTEGRITY_CHECK=n
CONFIG_SOC_PREP_HOOK=n
CONFIG_NETWORKING=n
CONFIG_MBOX=n
CONFIG_COMPILER_WARNINGS_AS_ERRORS=y
